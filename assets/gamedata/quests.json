  "q_ch1_vess_in_the_dark": {
    "questID": "q_ch1_vess_in_the_dark",
    "questName": "Vess in the Dark",
    "chapter": 1,
    "category": "Side",
    "difficulty": "4",
    "requiredAlignment": "Neutral",
    "objectives": [
      {
        "description": "Hear Vess out about what the Shroud left behind in her",
        "type": "Talk",
        "targetEnemyID": "",
        "targetItemID": "",
        "targetNPCName": "Vess",
        "locationID": "",
        "requiredAmount": 1
      }
    ],
    "rewardGold": 25,
    "rewardXP": 40,
    "rewardItemID": "",
    "alignmentChange": 0,
