+// ---------------------------------------------------------------------------
+// PROTO: the gamble card and the stat-pick card.
+
+List<TowerReward> protoDeal(
+    TowerRun run, List<TowerReward> cards, TowerTableKind table) {
+  final level = table == TowerTableKind.levelUp;
+  final r = towerRandom(
+      run.seed,
+      run.floor * 8 + (level ? 1 + towerLevelUpsTaken(run) % 7 : 0),
+      TowerStream.gamble);
+  final out = [...cards];
+  final open = [
+    for (var i = 0; i < out.length; i++)
+      if (out[i].kind != TowerRewardKind.clanOath) i,
+  ];
+  if (open.isEmpty) return out;
+  final gambleRoll = r.nextDouble();
+  final gambleAt = open[r.nextInt(open.length)];
+  final outcomeRoll = r.nextInt(1 << 30);
+  final statRoll = r.nextDouble();
+  final chance = level ? protoGambleLevel : protoGambleLoot;
+  final statChance = level ? protoStatPickLevel : protoStatPickLoot;
+  var gambled = -1;
+  if (gambleRoll < chance) {
+    final outcome = protoDrawOutcome(
+        level ? protoGambleLevelWeights : protoGambleLootWeights, outcomeRoll);
+    out[gambleAt] = TowerReward(TowerRewardKind.gamble, id: outcome);
+    gambled = gambleAt;
+    protoCount('gambleDealt');
+  }
+  if (statRoll < statChance) {
+    // The last card that is not the gamble, not a clan's, not an oath (on a
+    // Level Up table the die or the spell).
+    for (var i = out.length - 1; i >= 0; i--) {
+      if (i == gambled || out[i].kind == TowerRewardKind.clanOath) continue;
+      if (level && out[i].clan.isNotEmpty) continue;
+      out[i] = const TowerReward(TowerRewardKind.statPick);
+      protoCount('statPickDealt');
+      break;
+    }
+  }
+  return out;
+}
+
+Random _gambleRandom(TowerRun run, int salt) =>
+    towerRandom(run.seed, 4000 + run.floor * 8 + salt, TowerStream.gamble);
+
+void _wound(SimCharacter hero, double share) {
+  hero.currentHealth =
+      max(1, hero.currentHealth - (hero.maxHealth * share).round());
+}
+
+TowerRun protoResolveLoot(
+    TowerRun run, TowerReward card, SimCharacter hero, TowerData data) {
+  protoCount('gambleTaken');
+  protoCount('g_${card.id}');
+  final others = [
+    for (final c in run.offer)
+      if (c.kind != TowerRewardKind.gamble &&
+          c.kind != TowerRewardKind.statPick)
+        c,
+  ];
+  final marker = {...run.loot, run.floor: card};
+  switch (card.id) {
+    case 'gilded':
+      final drawn = towerRunLootFor(run, data, hero,
+          random: _gambleRandom(run, 0), tierBonus: 1);
+      TowerReward? best;
+      for (final c in drawn) {
+        if (c.kind != TowerRewardKind.gear) continue;
+        if (best == null ||
+            towerGearScore(c.id, data) > towerGearScore(best.id, data)) {
+          best = c;
+        }
+      }
+      best ??= drawn.firstWhere((c) => c.kind == TowerRewardKind.bundle,
+          orElse: () => drawn.first);
+      return towerTakeLoot(run, best, hero, data);
+    case 'twin':
+      if (others.isEmpty) return run.copyWith(loot: marker);
+      var next = towerTakeLoot(run, others.first, hero, data);
+      if (others.length > 1) {
+        next = towerTakeLoot(next, others[1], hero, data).copyWith(
+            loot: {...run.loot, run.floor: others.first},
+            gambles: {
+              ...run.gambles,
+              run.floor: [...?run.gambles[run.floor], others[1]],
+            });
+      }
+      return next;
+    case 'hoard':
+      final coins = 4 + 2 * towerLootBandOf(run.floor);
+      return run.copyWith(
+          loot: marker,
+          coins: run.coins + coins,
+          coinsEarned: run.coinsEarned + coins);
+    case 'wound':
+      _wound(hero, protoWound);
+      return run.copyWith(loot: marker);
+    case 'spill':
+      if (run.potions > 0) {
+        return run.copyWith(loot: marker, potions: run.potions - 1);
+      }
+      _wound(hero, protoWound / 2);
+      return run.copyWith(loot: marker);
+    default:
+      return run.copyWith(loot: marker);
+  }
+}
+
+TowerRun protoResolveLevel(TowerRun run, TowerReward card, SimCharacter hero,
+    TowerData data, List<TowerReward?> level) {
+  protoCount('gambleTaken');
+  protoCount('g_${card.id}');
+  void give(TowerReward c) {
+    towerApplyReward(hero, c, data, bag: run.dieChoice != null);
+    towerNudgeOn(hero, c, data, rules: run.rules);
+  }
+
+  final others = [
+    for (final c in run.offer)
+      if (c.kind != TowerRewardKind.gamble &&
+          c.kind != TowerRewardKind.clanOath &&
+          c.kind != TowerRewardKind.statPick)
+        c,
+  ];
+  switch (card.id) {
+    case 'bright':
+      final drawn = towerOfferFor(
+        seed: run.seed,
+        floor: run.floor,
+        hero: towerHeroView(run, hero),
+        clanPool: const [],
+        items: data.items,
+        dice: data.dice,
+        skills: data.skills,
+        spells: data.spells,
+        random: _gambleRandom(run, 1 + towerLevelUpsTaken(run) % 7),
+        avoid: {for (final c in run.offer) c.id},
+        levelUp: true,
+        levelUpOaths: false,
+        rarityBonus: 1,
+      );
+      final skill = drawn.where((c) =>
+          c.kind == TowerRewardKind.skill || c.kind == TowerRewardKind.rankUp);
+      final got = skill.isNotEmpty
+          ? skill.first
+          : (drawn.isNotEmpty ? drawn.first : null);
+      level.add(got);
+      if (got != null) give(got);
+      return run;
+    case 'twin':
+      if (others.isEmpty) {
+        level.add(null);
+        return run;
+      }
+      level.add(others.first);
+      give(others.first);
+      if (others.length > 1) {
+        give(others[1]);
+        return run.copyWith(gambles: {
+          ...run.gambles,
+          run.floor: [...?run.gambles[run.floor], others[1]],
+        });
+      }
+      return run;
+    case 'wound':
+      level.add(null);
+      _wound(hero, protoWound);
+      return run;
+    case 'hex':
+      level.add(null);
+      return run.copyWith(gambles: {
+        ...run.gambles,
+        run.floor: [
+          ...?run.gambles[run.floor],
+          const TowerReward(TowerRewardKind.gamble, id: 'hex'),
+        ],
+      });
+    default:
+      level.add(null);
+      return run;
+  }
+}
