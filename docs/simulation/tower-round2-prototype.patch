@@ -0,0 +1,121 @@
+// PROTOTYPE harness (not committed).
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:narrative_data_app/data/tower/tower_bot.dart';
+import 'package:narrative_data_app/data/tower/tower_coins.dart';
+import 'package:narrative_data_app/data/tower/tower_progress.dart';
+import 'package:narrative_data_app/data/tower/tower_proto.dart';
+import 'package:narrative_data_app/data/tower/tower_run.dart';
+import 'package:narrative_data_app/data/tower/tower_tables.dart';
+
+void main() {
+  test('props', () {
+    final env = Platform.environment;
+    double d(String k, double v) => double.tryParse(env[k] ?? '') ?? v;
+    int i(String k, int v) => int.tryParse(env[k] ?? '') ?? v;
+    protoGambleLoot = d('PROTO_GAMBLE_LOOT', 0);
+    protoGambleLevel = d('PROTO_GAMBLE_LEVEL', 0);
+    protoStatPickLevel = d('PROTO_STAT_LEVEL', 0);
+    protoStatPickLoot = d('PROTO_STAT_LOOT', 0);
+    protoBotGamble = env['PROTO_BOT_GAMBLE'] ?? 'hint';
+    protoBotStatPick = env['PROTO_BOT_STAT'] ?? 'damage';
+    protoPerks = i('PROTO_PERKS', 0);
+    protoPerGood = i('PROTO_PER_GOOD', 99);
+    protoPerKind = i('PROTO_PER_KIND', 99);
+    protoStatPickClimbCap = env['PROTO_CLIMBCAP'] == '1';
+    protoSecondWindFloor = d('PROTO_SW', protoSecondWindFloor);
+    protoEarlyWord = i('PROTO_EW', protoEarlyWord);
+    protoPurse = i('PROTO_PURSE', protoPurse);
+    protoOldFriendMode = env['PROTO_OFMODE'] ?? 'sworn';
+    protoOldFriendTier = i('PROTO_OF_TIER', 2);
+    protoEarlyWordXp = i('PROTO_EW_XP', 0);
+    protoKeenBand = i('PROTO_KEEN_BAND', 0);
+    protoFreeBand = i('PROTO_FREE_BAND', 0);
+    protoBotLootReroll = env['PROTO_BOT_LOOTREROLL'] == '1';
+    protoEarlyWordPotions = i('PROTO_EW_POT', 0);
+    protoFourthBand = i('PROTO_FOURTH_BAND', 0);
+    protoPedlarPrice = i('PROTO_PEDLAR', 0);
+    protoSecondWindPeak = d('PROTO_SW_PEAK', .15);
+    if (env['PROTO_GW'] == '2') {
+      protoGambleLootWeights = {
+        'gilded': 35, 'twin': 25, 'hoard': 10, 'dud': 10, 'wound': 12, 'spill': 8,
+      };
+      protoGambleLevelWeights = {
+        'bright': 35, 'twin': 30, 'dud': 15, 'wound': 12, 'hex': 8,
+      };
+    }
+    protoTopFrom = i('PROTO_TOP_FROM', 11);
+    protoWound = d('PROTO_WOUND', protoWound);
+    final scale = d('PROTO_SCALE', 1.0);
+    protoTopScale = scale;
+    final seeds = i('PROPS_SEEDS', 2000);
+    final data = towerDataFromAssets();
+    final out = File(env['PROPS_OUT']!);
+    for (final spec in (env['PROPS_CASES'] ?? 'none|none||0').split(';')) {
+      final p = spec.split('|');
+      final name = p[0];
+      final prog = p[1];
+      final perk = p.length > 2 ? p[2] : '';
+      final heat = p.length > 3 ? int.parse(p[3]) : 0;
+      final progress = prog == 'none'
+          ? const TowerProgress()
+          : prog == 'all'
+              ? towerAllUnlocked
+              : TowerProgress(unlocked: {prog});
+      protoCounters.clear();
+      protoPer.clear();
+      final runs = [
+        for (var s = 1; s <= seeds; s++)
+          playTowerRun(
+              seed: s,
+              data: data,
+              progress: progress,
+              events: i('PROPS_EVENTS', towerEventsLive),
+              heat: heat,
+              perks: towerWornPerks([if (perk.isNotEmpty) perk]),
+              coins: TowerBotCoins.full,
+              rules: towerRulesLive),
+      ];
+      double share(bool Function(TowerRun) t) =>
+          100 * runs.where(t).length / runs.length;
+      final floors = [for (final r in runs) r.floorReached]..sort();
+      Map<String, Object> pct(List<int> l) {
+        final s = [...l]..sort();
+        if (s.isEmpty) return {};
+        return {
+          'p10': s[s.length ~/ 10],
+          'p50': s[s.length ~/ 2],
+          'p90': s[s.length * 9 ~/ 10],
+          'max': s.last,
+          'mean': s.reduce((a, b) => a + b) / s.length,
+          'ge3': s.where((v) => v >= 3).length / s.length,
+          'ge4': s.where((v) => v >= 4).length / s.length,
+          'ge5': s.where((v) => v >= 5).length / s.length,
+          'ge6': s.where((v) => v >= 6).length / s.length,
+        };
+      }
+
+      out.writeAsStringSync(
+          '${jsonEncode({
+                'name': name,
+                'heat': heat,
+                'perk': perk,
+                'prog': prog,
+                'f5': share((r) => r.floorReached >= 5),
+                'f10': share((r) => r.floorReached >= 10),
+                'f20': share((r) => r.floorReached >= 20),
+                'top': share((r) => r.status == TowerStatus.won),
+                'median': floors[floors.length ~/ 2],
+                'counters': {...protoCounters},
+                'per': {
+                  for (final e in protoPer.entries) '${e.key}': pct(e.value)
+                },
+                'coins': runs.fold<int>(0, (n, r) => n + r.coinsEarned) /
+                    runs.length,
+              })}\n',
+          mode: FileMode.append);
+    }
+  }, timeout: Timeout.none);
+}
