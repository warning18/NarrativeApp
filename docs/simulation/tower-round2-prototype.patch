+String protoDrawOutcome(Map<String, int> w, int roll) {
+  final total = w.values.fold<int>(0, (n, v) => n + v);
+  var r = roll % total;
+  for (final e in w.entries) {
+    if (r < e.value) return e.key;
+    r -= e.value;
+  }
+  return w.keys.last;
+}
