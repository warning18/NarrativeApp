+/// The calling pass of rules 2 from floor [towerLootUpperFloor] (the first
+/// boss) on, on top of [towerLootProfessionScale]: the warrior fell behind
+/// at the first boss and after it, the mage pulled ahead.
+const Map<String, double> towerLootProfessionUpperScale = {
+  'warrior': .90,
+  'mage': 1.04,
+};
+const int towerLootUpperFloor = 10;
+
+/// The survival curve of rules 2 (the user's call: a roguelike climb, hard
+/// from floor 1, harder going up): every foe of floor n (index n - 1) this
+/// much more, on top of the floor's extra and the rest. Floors 1 to 4 about
+/// 4 rounds a fight (they fell in 1 or 2), floors 6 to 9 a step up, the
+/// wardens and bosses peaks. Measured with the slower levels
+/// ([towerXpPerLevel]): fewer levels mean foes that grow less
+/// (enemyScaledMaxHealth), so the curve is set with them.
+const List<double> towerSurvivalScale = [
+  3.0, 4.2, 4.5, 3.0, 2.1, // 1-5 (5: warden)
+  2.1, 2.1, 2.1, 2.1, 1.8, // 6-10 (10: boss)
+  1.5, 1.5, 1.5, 1.5, 1.6, // 11-15 (15: warden)
+  1.53, 1.53, 1.53, 1.53, 1.78, // 16-20 (20: boss)
+  1.56, 1.56, 1.56, 1.56, 1.66, // 21-25 (25: warden)
+  1.56, 1.56, 1.56, 1.56, 1.75, // 26-30 (30: boss)
+];
+
+/// The factor rules [rules] put on the foes of floor [floor] for a hero of
+/// [professionId]: 1 on rules 1; on rules 2 [towerLootFoeScale], the
+/// calling's [towerLootProfessionScale] (and [towerLootProfessionUpperScale]
+/// from [towerLootUpperFloor]) and the floor's [towerSurvivalScale] (none
+/// for a [floor] of 0).
+double towerRulesScaleOf(int rules, String professionId, {int floor = 0}) =>
+    rules >= 2
+        ? towerLootFoeScale *
+            (towerLootProfessionScale[professionId] ?? 1.0) *
+            (floor >= towerLootUpperFloor
+                ? towerLootProfessionUpperScale[professionId] ?? 1.0
+                : 1.0) *
+            (floor >= 1 && floor <= towerSurvivalScale.length
+                ? towerSurvivalScale[floor - 1]
+                : 1.0)
+        : 1.0;
+
+/// The max health an unlock gives on rules 2: [towerHealthPerUnlockOf]
+/// this many times (the marks' unlocks make the top reachable: about 10%
+/// with all of them, under 0.5% with none), and the calling's share of it
+/// ([towerLootProfessionHealthPerUnlock]).
+const double towerLootHealthPerUnlockScale = 5.33;
+const Map<String, double> towerLootProfessionHealthPerUnlock = {
+  'cleric': .90,
+  'rogue': .75,
+  'mage': 1.15,
+  'warrior': .85,
+};
+
+/// The share of max health a hero of [raceId] and [professionId] gains per
+/// unlock owned on rules [rules].
+double towerHealthPerUnlockFor(String raceId, String professionId,
+        {int rules = 1}) =>
+    towerHealthPerUnlockOf(raceId) *
+    (rules >= 2
+        ? towerLootHealthPerUnlockScale *
+            (towerLootProfessionHealthPerUnlock[professionId] ?? 1.0)
+        : 1.0);
+
+/// The share of max health back after a floor won on rules 2 (rules 1:
+/// [towerRecoveryShare]): HP is the climb's resource. Heat 3 and up keep
+/// [towerHeatRecoveryShare].
+const double towerLootRecoveryShare = .10;
+
+/// The share of max health back after a floor won at [heat] on rules 2.
+double towerLootRecoveryShareOf(int heat) =>
+    heat >= towerHeatFlame ? towerHeatRecoveryShare : towerLootRecoveryShare;
 
