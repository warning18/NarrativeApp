+
+// ---- PROTOTYPE (scratch, never committed) ---------------------------------
+String protoMode = 'A';
+List<String>? protoAllies;
+
+class _FighterRow extends StatefulWidget {
+  const _FighterRow({required this.allies, required this.foes, required this.h});
+  final List<String> allies; // 'hero' or a companion id
+  final List<String> foes;
+  final double h;
+  @override
+  State<_FighterRow> createState() => _FighterRowState();
+}
+
+class _FighterRowState extends State<_FighterRow> {
+  FightSpriteSet? _set(String id, bool ally) => id == 'hero'
+      ? roninSprite
+      : ally
+          ? companionFightSprite(id)
+          : enemyFightSprite(id);
+  @override
+  void initState() {
+    super.initState();
+    for (final id in widget.allies) {
+      final s = _set(id, true);
+      if (s != null) FightSpriteImages.load(s);
+    }
+    for (final id in widget.foes) {
+      final s = _set(id, false);
+      if (s != null) FightSpriteImages.load(s);
+    }
+  }
+
+  Widget _fig(String id, bool ally) {
+    final s = _set(id, ally);
+    if (s == null) return SizedBox(width: widget.h);
+    return ValueListenableBuilder<int>(
+      valueListenable: FightSpriteImages.loaded,
+      builder: (_, __, ___) {
+        final img = FightSpriteImages.idleOf(s);
+        final use = FightSpriteImages.effective(s);
+        final k = widget.h / 48 * use.drawScale;
+        final w = use.frameWidth * k, hh = use.frameHeight * k;
+        return SizedBox(
+          width: w,
+          height: widget.h,
+          child: img == null
+              ? null
+              : OverflowBox(
+                  alignment: Alignment.bottomCenter,
+                  minHeight: hh, maxHeight: hh, minWidth: w, maxWidth: w,
+                  child: Transform.translate(
+                    offset: Offset(0, use.footInset * k),
+                    child: Transform.scale(
+                      scaleX: (ally && !use.facesEast) ? -1 : 1,
+                      child: CustomPaint(size: Size(w, hh), painter: _ProtoPainter(img, use)),
+                    ),
+                  ),
+                ),
+        );
+      },
+    );
+  }
+
+  @override
+  Widget build(BuildContext context) => SizedBox(
+        height: widget.h,
+        child: Row(children: [
+          Expanded(child: Row(mainAxisAlignment: MainAxisAlignment.spaceEvenly, crossAxisAlignment: CrossAxisAlignment.end, children: [for (final a in widget.allies) Flexible(child: FittedBox(fit: BoxFit.scaleDown, alignment: Alignment.bottomCenter, child: _fig(a, true)))])),
+          const SizedBox(width: 8),
+          Expanded(child: Row(mainAxisAlignment: MainAxisAlignment.spaceEvenly, crossAxisAlignment: CrossAxisAlignment.end, children: [for (final f in widget.foes) Flexible(child: FittedBox(fit: BoxFit.scaleDown, alignment: Alignment.bottomCenter, child: _fig(f, false)))])),
+        ]),
+      );
+}
+
+class _ProtoPainter extends CustomPainter {
+  _ProtoPainter(this.img, this.set);
+  final ui.Image img;
+  final FightSpriteSet set;
+  @override
+  void paint(Canvas c, Size s) => c.drawImageRect(img, Rect.fromLTWH(0, 0, set.frameWidth.toDouble(), set.frameHeight.toDouble()), Offset.zero & s, Paint()..filterQuality = FilterQuality.none..isAntiAlias = false);
+  @override
+  bool shouldRepaint(_) => false;
+}
